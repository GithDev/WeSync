# Normalize all text files to LF in the repo and the working tree.
# (The working tree was previously CRLF on Windows via core.autocrlf=true,
#  which made the airbnb `linebreak-style: unix` lint rule fail locally.)
* text=auto eol=lf

# Binary assets — never line-ending-normalize.
*.png  binary
*.ico  binary
*.svg  text eol=lf
*.jar  binary
*.so   binary
*.exe  binary
*.dll  binary
