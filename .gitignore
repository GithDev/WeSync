# Build outputs
*.exe
*.exe~

# Temp NSIS script the Docker Windows build generates (forward-slash source paths
# for POSIX makensis); removed after each build.
platform/windows/*.gen.nsi

# Windows resource object generated by go-winres during the Docker build (icon +
# manifest for wesync-app.exe); removed after each build.
cmd/app/rsrc_windows_*.syso

# Generated directories (never commit)
dist/
testdata/
data/
test-results/
web/dist/
node_modules/

# Embedded frontend bundle — regenerated by `npm run build` + copy into
# mobile/webdist/. Committing it would double-track every web change.
mobile/webdist/

# OS
.DS_Store
Thumbs.db

# Android build artifacts
# Local Gradle config — created per-machine by Android Studio; holds an absolute
# sdk.dir path that leaks the local username. Must never be committed.
platform/android/local.properties
platform/android/app/build/
platform/android/build/
platform/android/.gradle/
# AAR (+ its sources jar) is regenerated by `gomobile bind` on every build
# (make android / build.ps1). ~12 MB, rebuild <10s. Gradle only consumes the
# .aar (build.gradle.kts); the sources jar is an IDE-only byproduct.
platform/android/app/libs/*.aar
platform/android/app/libs/*.jar

# Release signing — NEVER commit keystores or their passwords. The release key
# is injected via env vars / GitHub Secrets at build time.
*.jks
*.keystore
keystore.properties
*.pfx
*.p12
platform/windows/codesign.*
.claude

# Stray dev artifacts — must never reach the public repo.
# Hand-built Go service binary at the repo root. Anchored with a leading slash so
# it never matches the Android app module platform/android/app/. ~10 MB.
/app
# Ad-hoc test-output logs land in the repo root during dev runs. Anchor to root
# only so the fastlane store-listing texts (fastlane/.../*.txt) survive.
/*.txt
# JetBrains / Android Studio per-machine project settings.
.idea/
# Syncthing drops this marker dir into every folder it syncs.
.stfolder/